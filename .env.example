# ==============================================================================
# AUDRYN — ENVIRONMENT CONFIGURATION TEMPLATE
# Evidence-First Multi-Agent Financial Audit Intelligence System
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENV=production
DEBUG=false
AUDRYN_DB_PATH=data/audryn_audit.db
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND DOMAIN
# ------------------------------------------------------------------------------
FRONTEND_URL=https://frontend-chi-nine-98.vercel.app

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & BOOTSTRAP SECURITY
# ------------------------------------------------------------------------------
# In production, AUDRYN generates a secure CSPRNG password if left unset.
# Set an explicit password for the initial Partner administrator:
AUDRYN_PARTNER_PASSWORD=
SESSION_SECRET_KEY=audryn-production-session-secret-change-in-production-2026

# ------------------------------------------------------------------------------
# 4. AI INFERENCE MODE & DATA GOVERNANCE
# ------------------------------------------------------------------------------
# Mode: 'local' (Ollama -> Gemini -> Groq -> NVIDIA NIM) or 'cloud' (Gemini -> Groq -> NVIDIA NIM)
AI_PROVIDER_MODE=local

# When 'false', confidential client financial records are NEVER sent to cloud LLMs
AI_ALLOW_CONFIDENTIAL_EXTERNAL_DATA=false

# Timeouts & Circuit Breaker
AI_TIMEOUT_SECONDS=15.0
AI_CIRCUIT_FAIL_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60.0

# ------------------------------------------------------------------------------
# 5. PROVIDER API KEYS & CONFIGURATIONS
# ------------------------------------------------------------------------------

# Local Private Inference (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Google Gemini (Primary Cloud Reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (Ultra-Low Latency LPU)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM (Enterprise Nemotron)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
