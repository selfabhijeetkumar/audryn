# AUDRYN Environment Configuration Template
# Copy to .env and configure local values. Do NOT commit actual secrets to version control.

# Application Settings
AUDRYN_ENV=development
AUDRYN_DEBUG=true
AUDRYN_LOG_LEVEL=INFO
AUDRYN_PORT=8000

# Local AI / Ollama Inference (Default: Local-first, zero cost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Database (Local SQLite for Phase 1)
DATABASE_URL=sqlite:///./audryn_local.db

# Security & Session
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Locations
SYNTHETIC_DATA_DIR=./data/synthetic
UPLOAD_DIR=./uploads/private
REPORTS_DIR=./data/reports
